# MCP Server
PORT=3000
# Long MCP tools: Node 18+ defaults requestTimeout to 5m; 0 disables (see README "Timeouts").
# MCP_HTTP_REQUEST_TIMEOUT_MS=0
# MCP_HTTP_HEADERS_TIMEOUT_MS=
# MCP_HTTP_KEEP_ALIVE_TIMEOUT_MS=

# Recommendator agent REST API URL (for Agent tab status and future chat).
# Also used by trading-agent worker to send "run again" every 10 minutes.
# Example: http://localhost:8000 (ADK api_server default)
# AGENT_API_URL=http://localhost:8000

# Trading agent worker: app name as returned by ADK list-apps (default: trading_agent).
# TRADING_APP_NAME=trading_agent

# Optimizer agent worker: interval in minutes (default 20); app name from list-apps (default: optimizer_agent).
# OPTIMIZER_AGENT_INTERVAL_MINUTES=20
# OPTIMIZER_APP_NAME=optimizer_agent

# Database: PostgreSQL only (required). Schema is applied on MCP/worker startup (see src/db/schema/postgres-ddl.sql).
# `.env` is loaded from process.cwd() or the repo root (see src/db/load-env.ts). Run the app from the project root, or set vars in the shell.
# If DATABASE_URL is already set in the shell, dotenv will not override it unless you unset it first.
# Example (create the database first). URL-encode special characters in USER/PASSWORD.
# Managed Postgres often needs TLS: append ?sslmode=require (or verify-full as required by your provider).
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/amadeus
# DATABASE_URL=postgresql://USER:PASSWORD@host.example.com:5432/amadeus?sslmode=require
#
# PostgreSQL + `tsx` / `npm run test:db`: the DB worker runs in a child thread. If the app hangs on DB access,
# run `npm run build` and set AMADEUS_PG_USE_DIST_WORKER=1 so the compiled `dist/db/pg-worker.js` is used, or rely on
# synckit + tsx (tsx must be installed). Optional: AMADEUS_DB_SYNCKIT_TIMEOUT_MS=120000 (default 120s) so a stuck worker errors instead of hanging forever.

# Helius RPC URL (required). Used for all Solana RPC: balance sync, execution, chain-snapshots, pumpswap-pairs worker. Only Helius is supported; direct Solana RPC is not used.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_RPC_URL=

# Redis URL (required for PumpSwap vault swap worker). Used for pub/sub: pumpswap-pairs worker publishes new pairs to channel "pairs:new"; vault swap worker subscribes and subscribes vault watchers for new pairs without DB polling.
# Example: redis://localhost:6379
# REDIS_URL=

# Optional: Chainlink SOL/USD feed account on Solana. When set with HELIUS_RPC_URL, SOL price is read from Chainlink via RPC instead of CoinGecko/Binance. Get mainnet address from https://docs.chain.link/data-feeds/price-feeds/addresses?network=solana
# CHAINLINK_SOL_USD_FEED_ADDRESS=

# Chain snapshots worker: interval between snapshot cycles in seconds. Only 15, 30, or 60 allowed; default 60.
# SNAPSHOT_POLL_INTERVAL_SEC=60

# Solana signer for live execution (env only; never in DB or UI). Base58 secret key or JSON array (Phantom-style) of 64 bytes.
# SOLANA_PRIVATE_KEY=

# When 'true', live Solana executor does not send transactions (simulate only).
# LIVE_EXECUTION_DRY_RUN=false

# Moralis API key for Solana token holder data (optional). When set, DexScreener-API snapshots are enriched with holder count and top-holder % from Moralis.
# MORALIS_API_KEY=your_api_key
