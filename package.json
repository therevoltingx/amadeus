{
  "name": "amadeus",
  "version": "1.0.0",
  "type": "module",
  "description": "An AI driven trading bot for fresh Solana memecoins",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/schema && cp src/db/schema/postgres-ddl.sql dist/db/schema/postgres-ddl.sql",
    "start": "node dist/index.js",
    "up": "bash scripts/amadeus.sh start",
    "down": "bash scripts/amadeus.sh stop",
    "restart": "bash scripts/amadeus.sh restart",
    "status": "bash scripts/amadeus.sh status",
    "logs": "bash scripts/amadeus.sh logs",
    "dev": "tsc --watch",
    "worker:scoring": "node dist/workers/scoring-worker.js",
    "worker:scoring:dev": "tsx watch src/workers/scoring-worker.ts",
    "worker:execution": "node dist/workers/execution-worker.js",
    "worker:execution:dev": "tsx watch src/workers/execution-worker.ts",
    "worker:exit": "node dist/workers/exit-worker.js",
    "worker:exit:dev": "tsx watch src/workers/exit-worker.ts",
    "worker:policy-analytics": "node dist/workers/policy-analytics-worker.js",
    "worker:policy-analytics:dev": "tsx watch src/workers/policy-analytics-worker.ts",
    "worker:pumpswap-pairs": "node dist/workers/pumpswap-pairs-worker.js",
    "worker:pumpswap-pairs:dev": "tsx watch src/workers/pumpswap-pairs-worker.ts",
    "worker:pumpswap-vault-swap": "node dist/workers/pumpswap-vault-swap-worker.js",
    "worker:pumpswap-vault-swap:dev": "tsx watch src/workers/pumpswap-vault-swap-worker.ts",
    "worker:chain-snapshots": "node dist/workers/chain-snapshots-worker.js",
    "worker:chain-snapshots:dev": "tsx watch src/workers/chain-snapshots-worker.ts",
    "worker:backtest": "node dist/workers/backtest-worker.js",
    "worker:backtest:dev": "tsx watch src/workers/backtest-worker.ts",
    "worker:account-balance": "node dist/workers/account-balance-worker.js",
    "worker:account-balance:dev": "tsx watch src/workers/account-balance-worker.ts",
    "worker:optimizer-agent": "node dist/workers/optimizer-agent-worker.js",
    "worker:optimizer-agent:dev": "tsx watch src/workers/optimizer-agent-worker.ts",
    "mcp": "node dist/mcp-server/index.js",
    "mcp:dev": "tsx watch --include \"src/**/*\" src/mcp-server/index.ts",
    "sell-dust": "node dist/scripts/sell-dust.js",
    "sell-dust:dev": "tsx src/scripts/sell-dust.ts",
    "ui": "cd ui && npm run dev",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:db": "tsx src/scripts/test-db-connection.ts",
    "test:db:dist": "node dist/scripts/test-db-connection.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@pump-fun/pump-swap-sdk": "^1.13.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.32-alpha",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "lru-cache": "^10.4.3",
    "pg": "^8.20.0",
    "pumpfun-pumpswap-sdk": "github:Erbsensuppee/pumpfun-pumpswap-sdk",
    "synckit": "^0.11.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "helius-mcp": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
